#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
hostname aetheros
echo ""
echo "  AetherOS - built from scratch"
echo ""
depmod -a 2>/dev/null || true
for m in virtio_pci virtio_blk virtio_net virtio_gpu drm_kms_helper; do
  modprobe "$m" 2>/dev/null || true
done
exec /bin/sh
